+# Tests of the `offset` parameter (see GitHub issue #24614).
+@pytest.mark.parametrize("solver", ["lbfgs", "newton-cholesky"])
+@pytest.mark.parametrize("fit_intercept", [True, False])
+def test_glm_offset_zero_is_no_offset(solver, fit_intercept):
+    X, y = make_regression(n_samples=200, n_features=4, noise=1, random_state=0)
+    y = np.exp(y / np.abs(y).max())
+    params = dict(alpha=0.1, solver=solver, fit_intercept=fit_intercept, tol=1e-10)
+    glm = PoissonRegressor(**params).fit(X, y)
+    glm_zero = PoissonRegressor(**params).fit(X, y, offset=np.zeros(y.shape[0]))
+    assert_allclose(glm_zero.coef_, glm.coef_, rtol=1e-8, atol=1e-10)
+    assert_allclose(glm_zero.intercept_, glm.intercept_, rtol=1e-8, atol=1e-10)
