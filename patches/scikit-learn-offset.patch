+def test_logistic_offset_prediction_methods():
+    X, y, offset = _offset_data()
+    lr = LogisticRegression().fit(X, y, offset=offset)
+    base = lr.decision_function(X)
+    scores = lr.decision_function(X, offset=offset)
+    assert_allclose(scores, base + offset)
+    proba = lr.predict_proba(X, offset=offset)
+    assert_allclose(proba[:, 1], 1 / (1 + np.exp(-scores)))
+    assert_allclose(proba.sum(axis=1), 1)
+    assert_allclose(lr.predict_log_proba(X, offset=offset), np.log(proba))
+    assert_array_equal(lr.predict(X, offset=offset), lr.classes_[(scores > 0).astype(int)])
+    assert_array_equal(lr.predict(X), lr.predict(X, offset=None))
