+    params = dict(solver=solver, tol=1e-10, max_iter=1000)
+    lr = LogisticRegression(**params).fit(X, y)
+    lr_c = LogisticRegression(**params).fit(X, y, offset=np.full(y.shape[0], 2.0))
+    assert_allclose(lr_c.coef_, lr.coef_, atol=1e-7)
+    assert_allclose(lr_c.intercept_, lr.intercept_ - 2.0, atol=1e-7)
