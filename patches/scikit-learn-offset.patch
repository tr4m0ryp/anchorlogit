+@pytest.mark.parametrize("solver", ["lbfgs", "newton-cholesky"])
+@pytest.mark.parametrize("alpha", [0.0, 0.1])
+def test_poisson_offset_is_log_exposure(solver, alpha):
+    """offset = log(exposure) minimizes the stated objective with the offset."""
+    rng = np.random.RandomState(42)
+    n_samples, n_features = 300, 3
+    X = rng.normal(size=(n_samples, n_features))
+    exposure = rng.uniform(0.5, 5, size=n_samples)
+    rate = np.exp(X @ np.array([0.3, -0.2, 0.1]) - 0.5)
+    y = rng.poisson(rate * exposure)
+    offset = np.log(exposure)
+    sw = rng.uniform(0.5, 1.5, size=n_samples)
+    glm = PoissonRegressor(alpha=alpha, solver=solver, tol=1e-10, max_iter=1000)
+    glm.fit(X, y, sample_weight=sw, offset=offset)
+
+    def objective(theta):
+        raw = X @ theta[:-1] + theta[-1] + offset
+        loss = np.exp(raw) - y * raw  # half Poisson deviance up to a constant
+        return sw @ loss / sw.sum() + 0.5 * alpha * theta[:-1] @ theta[:-1]
+
+    expected = minimize(
+        objective, np.zeros(n_features + 1), method="BFGS", options={"gtol": 1e-10}
+    ).x
+    assert_allclose(np.r_[glm.coef_, glm.intercept_], expected, atol=1e-5)
+    mu = np.exp(X @ glm.coef_ + glm.intercept_ + offset)
+    assert_allclose(glm.predict(X, offset=offset), mu)
+    assert_allclose(glm.predict(X), mu / exposure)
+
+
+def test_poisson_offset_equals_rate_with_sample_weight():
+    """Unpenalized: offset log(e) on counts equals sample_weight e on rates y / e."""
+    rng = np.random.RandomState(0)
+    X = rng.normal(size=(200, 2))
+    exposure = rng.uniform(0.5, 3, size=200)
+    y = rng.poisson(np.exp(X @ np.array([0.5, -0.3])) * exposure)
+    a = PoissonRegressor(alpha=0, tol=1e-12, solver="newton-cholesky")
+    a.fit(X, y, offset=np.log(exposure))
+    b = PoissonRegressor(alpha=0, tol=1e-12, solver="newton-cholesky")
+    b.fit(X, y / exposure, sample_weight=exposure)
+    assert_allclose(a.coef_, b.coef_, rtol=1e-7)
+    assert_allclose(a.intercept_, b.intercept_, rtol=1e-7)
+
+
+def test_glm_offset_newton_cholesky_large_offset():
+    """The Newton line search must not add the offset to the step direction."""
+    rng = np.random.RandomState(1)
+    X = rng.normal(size=(300, 3))
+    offset = rng.uniform(2, 6, size=300)
+    y = rng.poisson(np.exp(X @ np.array([0.2, -0.1, 0.05]) + offset))
+    with warnings.catch_warnings():
+        warnings.simplefilter("error", ConvergenceWarning)
+        nc = PoissonRegressor(alpha=1e-3, solver="newton-cholesky", tol=1e-10)
+        nc.fit(X, y, offset=offset)
+    lb = PoissonRegressor(alpha=1e-3, solver="lbfgs", tol=1e-12, max_iter=10_000)
+    lb.fit(X, y, offset=offset)
+    assert nc.n_iter_ < 30
+    assert_allclose(nc.coef_, lb.coef_, rtol=1e-5, atol=1e-6)
