+def test_glm_offset_score_and_validation():
+    rng = np.random.RandomState(2)
+    X = rng.normal(size=(100, 2))
+    offset = rng.normal(size=100)
+    y = rng.poisson(np.exp(offset))
+    glm = PoissonRegressor().fit(X, y, offset=offset)
+    assert glm.score(X, y, offset=offset) > glm.score(X, y)
