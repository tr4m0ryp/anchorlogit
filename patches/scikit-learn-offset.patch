+def _offset_data(n_samples=300, n_features=4, seed=0):
+    rng = np.random.RandomState(seed)
+    X = rng.normal(size=(n_samples, n_features))
+    offset = 1.5 * rng.normal(size=n_samples)
+    raw = X @ np.linspace(1, -1, n_features) + 0.3 + offset
+    y = (rng.uniform(size=n_samples) < 1 / (1 + np.exp(-raw))).astype(int)
+    return X, y, offset
+
+
+@pytest.mark.parametrize("solver", OFFSET_SOLVERS)
+@pytest.mark.parametrize("fit_intercept", [True, False])
+def test_logistic_offset_zero_is_no_offset(solver, fit_intercept):
+    """offset=zeros gives the same fit as offset=None."""
+    X, y, _ = _offset_data()
+    params = dict(solver=solver, fit_intercept=fit_intercept, tol=1e-10, max_iter=1000)
+    lr = LogisticRegression(**params).fit(X, y)
+    lr_zero = LogisticRegression(**params).fit(X, y, offset=np.zeros(y.shape[0]))
+    assert_allclose(lr_zero.coef_, lr.coef_, rtol=1e-10, atol=1e-12)
+    assert_allclose(lr_zero.intercept_, lr.intercept_, rtol=1e-10, atol=1e-12)
+
+
+@pytest.mark.parametrize("solver", OFFSET_SOLVERS)
+@pytest.mark.parametrize("C", [0.05, 1.0, np.inf])
+def test_logistic_offset_minimizes_objective(solver, C):
+    """The fit minimizes C * sum(sw * loss(X @ w + b + offset)) + ||w||^2 / 2."""
+    X, y, offset = _offset_data()
+    sw = np.random.RandomState(1).uniform(0.5, 1.5, size=y.shape[0])
+
+    def objective(theta):
+        raw = X @ theta[:-1] + theta[-1] + offset
+        loss = np.logaddexp(0, raw) - y * raw
+        penalty = 0 if np.isinf(C) else 0.5 * theta[:-1] @ theta[:-1] / C
+        return sw @ loss + penalty
+
+    expected = optimize.minimize(
+        objective, np.zeros(X.shape[1] + 1), method="BFGS", options={"gtol": 1e-10}
+    ).x
+    lr = LogisticRegression(C=C, solver=solver, tol=1e-10, max_iter=1000)
+    lr.fit(X, y, sample_weight=sw, offset=offset)
+    assert_allclose(np.r_[lr.coef_.ravel(), lr.intercept_], expected, atol=1e-5)
+
