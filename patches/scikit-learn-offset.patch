+def test_offset_equals_shifted_raw_prediction(base_loss, fit_intercept, sample_weight):
+    """Loss, gradient and hessian with an offset equal those at raw + offset."""
+    n_samples, n_features = 10, 5
+    loss = LinearModelLoss(base_loss=base_loss(), fit_intercept=fit_intercept)
+    X, y, coef = random_X_y_coef(loss, n_samples=n_samples, n_features=n_features)
+    rng = np.random.RandomState(0)
+    if base_loss.is_multiclass:
+        offset = rng.normal(size=(n_samples, loss.base_loss.n_classes))
+    else:
+        offset = rng.normal(size=n_samples)
+    if sample_weight == "range":
+        sample_weight = np.linspace(1, y.shape[0], num=y.shape[0])
+    loss_off = LinearModelLoss(
+        base_loss=base_loss(), fit_intercept=fit_intercept, offset=offset
+    )
+    _, _, raw = loss.weight_intercept_raw(coef, X)
+    _, _, raw_off = loss_off.weight_intercept_raw(coef, X)
+    assert_allclose(raw_off, raw + offset)
+    _, _, raw_dir = loss_off.weight_intercept_raw(coef, X, add_offset=False)
+    assert_allclose(raw_dir, raw)
+    kw = dict(sample_weight=sample_weight, l2_reg_strength=0.3)
+    assert_allclose(
+        loss_off.loss(coef, X, y, **kw), loss.loss(coef, X, y, raw_prediction=raw_off, **kw)
+    )
+    l_off, g_off = loss_off.loss_gradient(coef, X, y, **kw)
+    l_ref, g_ref = loss.loss_gradient(coef, X, y, raw_prediction=raw_off, **kw)
+    assert_allclose(l_off, l_ref)
+    assert_allclose(g_off, g_ref)
+    assert_allclose(loss_off.gradient(coef, X, y, **kw), g_ref)
+    g_h, h_h, _ = loss_off.gradient_hessian(coef, X, y, **kw)
+    g_h_ref, h_h_ref, _ = loss.gradient_hessian(coef, X, y, raw_prediction=raw_off, **kw)
+    assert_allclose(g_h, g_h_ref)
+    assert_allclose(h_h, h_h_ref)
+    g_p, hessp = loss_off.gradient_hessian_product(coef, X, y, **kw)
+    assert_allclose(g_p, g_ref)
+    vec = rng.normal(size=coef.size).reshape(coef.shape)
+    if base_loss.is_multiclass:
+        # hessian is (n_classes * n_dof, n_classes * n_dof) in F-order of coef
+        vec_flat = vec.ravel(order="F")
+        assert_allclose(hessp(vec).ravel(order="F"), h_h_ref @ vec_flat, rtol=1e-6)
+    else:
+        assert_allclose(hessp(vec), h_h_ref @ vec, rtol=1e-6)
